# =============================================
# GuiaOrientador-UnB — Variáveis de Ambiente
# =============================================
# Copie para .env e preencha os valores reais.

# ---- PostgreSQL + pgvector ----
POSTGRES_USER=guia_orientador
POSTGRES_PASSWORD=changeme_pg_password
POSTGRES_DB=guia_orientador_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# ---- Object storage S3 (SeaweedFS; compatível com o cliente MinIO) ----
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=changeme_minio_password
MINIO_ENDPOINT=seaweedfs:8333
MINIO_BUCKET_BRONZE=bronze
MINIO_BUCKET_SILVER=silver

# ---- OpenAI API (Embeddings + LLM) ----
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_LLM_MODEL=gpt-4o-mini

# ---- FastAPI ----
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=changeme_secret_key

# ---- RAG Configuration ----
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5
EMBEDDING_DIMENSION=1536
